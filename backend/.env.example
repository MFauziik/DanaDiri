PORT=5000
MONGO_URI=mongodb://localhost:27017/danadiri
JWT_SECRET=your_jwt_secret_key_change_this_in_production
NODE_ENV=development

# Email Configuration (Multi-Provider with Fallback)

# Priority 1: Resend (Railway-friendly, 100 free emails/day)
RESEND_API_KEY=re_your_resend_api_key_here

# Priority 2: SendGrid (Can email anyone, requires setup)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=noreply@danadiri.com

# Priority 3: SMTP (Last resort, connection issues possible)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Common settings
EMAIL_FROM=DanaDiri <noreply@danadiri.com>

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=